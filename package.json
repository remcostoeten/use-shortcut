{
  "name": "use-shortcut-workspace",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docs:dev": "turbo run dev --filter=@remcostoeten/use-shortcut-docs",
    "docs:build": "turbo run build --filter=@remcostoeten/use-shortcut-docs",
    "docs:lint": "turbo run lint --filter=@remcostoeten/use-shortcut-docs",
    "docs:test": "turbo run test --filter=@remcostoeten/use-shortcut-docs",
    "package:build": "turbo run build --filter=@remcostoeten/use-shortcut",
    "package:test": "turbo run test --filter=@remcostoeten/use-shortcut",
    "package:typecheck": "turbo run typecheck --filter=@remcostoeten/use-shortcut"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.6"
  }
}
