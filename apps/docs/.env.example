# Analytics (@remcostoeten/analytics)
# Registry docs hardcode ingestion to https://ingestion.remcostoeten.nl in src/lib/analytics.ts
# Optional: set to "true" to disable client-side tracking in local dev
# VITE_ANALYTICS_DISABLED=true
# VITE_ANALYTICS_PROJECT_ID=registry-docs

# Per-entry docs site URLs (not ingestion — see above)
VITE_DOCS_MODE=registry
VITE_SITE_URL=https://registry.remcostoeten.nl
VITE_REGISTRY_SITE_URL=https://registry.remcostoeten.nl
VITE_REGISTRY_TITLE=Remco Stoeten Registry
VITE_REGISTRY_OWNER=Remco Stoeten
VITE_REGISTRY_DESCRIPTION=Packages, CLIs, extensions, and companion docs published by Remco Stoeten.

# Optional per-entry domains.
# Naming convention: VITE_<SLUG>_DOCS_URL
VITE_USE_SHORTCUT_DOCS_URL=https://use-shortcut.remcostoeten.nl
VITE_ANALYTICS_DOCS_URL=https://analytics.remcostoeten.nl
VITE_VSCODE_CODE_REFINERY_DOCS_URL=https://vscode-code-refinery.remcostoeten.nl

# Optional dedicated single-entry deployment
# VITE_DOCS_MODE=package
# VITE_PRIMARY_PACKAGE_SLUG=use-shortcut
# VITE_SITE_URL=https://use-shortcut.remcostoeten.nl

# Also used by scripts/generate-sitemap.mjs for sitemap/robots URLs
SITE_URL=https://registry.remcostoeten.nl
