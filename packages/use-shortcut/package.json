{
    "name": "@remcostoeten/use-shortcut",
    "version": "1.0.0",
    "description": "Beautiful, intuitive, chainable syntax for executing keyboard shortcuts in React and Next.js with perfect TypeScript IntelliSense.",
    "author": "Remco Stoeten",
    "license": "MIT",
    "homepage": "https://github.com/remcostoeten/use-shortcut#readme",
    "bugs": {
        "url": "https://github.com/remcostoeten/use-shortcut/issues"
    },
    "packageManager": "bun@1.3.3",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/remcostoeten/use-shortcut.git"
    },
    "keywords": [
        "keyboard",
        "shortcuts",
        "hotkeys",
        "react",
        "hooks",
        "typescript",
        "chainable"
    ],
    "sideEffects": false,
    "bin": {
        "use-shortcut": "./dist/cli/index.mjs"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.9",
        "react": "^19.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    }
}